# Copy to .env and fill in real values. Never commit real secrets.
# After changing JWT_SECRET_KEY, all existing tokens are invalidated: log in again.

# Qdrant Cloud (https) or local Qdrant URL
QDRANT_URL=https://your-cluster.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Groq LLM API key
GROQ_API_KEY=your-groq-api-key-here
# Supported chat model (llama-3.3-70b-versatile is retired). Verified 2026-10-14.
# Options include: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# HS256 signing secret: at least 32 random bytes (64+ chars recommended).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_48_PLUS_RANDOM_CHARS_MIN_32_BYTES